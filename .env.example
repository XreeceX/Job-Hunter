# Database (PostgreSQL)
# Local: postgresql://user:password@localhost:5432/jobhunter?schema=public
# 24/7 (Vercel): use a hosted Postgres (e.g. Neon from Vercel Marketplace) – no local DB to run
DATABASE_URL="postgresql://user:password@localhost:5432/jobhunter?schema=public"

# AI: provider-agnostic (groq = default, openai = fallback)
LLM_PROVIDER=groq
GROQ_API_KEY="gsk_..."

# Optional: use OpenAI instead (set LLM_PROVIDER=openai and OPENAI_API_KEY)
# LLM_PROVIDER=openai
# OPENAI_API_KEY="sk-..."

# Vercel Blob (optional): resume files stored in Blob when set. On Vercel, add a Blob store and use BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN=

# Local only: file storage path when not using Vercel Blob (default: ./uploads)
UPLOAD_DIR=./uploads
