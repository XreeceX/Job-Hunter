# Database (PostgreSQL) – Prisma reads DATABASE_URL only
# Local: postgresql://user:password@localhost:5432/jobhunter?schema=public
# Vercel + Neon: use the connection string from Neon (Vercel may inject POSTGRES_URL – if so, set DATABASE_URL to that value)
DATABASE_URL="postgresql://neondb_owner:npg_UOEwcYjxzd13@ep-dry-sea-ab2gqnox-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# AI
LLM_PROVIDER=groq
GROQ_API_KEY="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"

# Optional: OpenAI fallback
# LLM_PROVIDER=openai
# OPENAI_API_KEY="sk-..."

# Vercel Blob: must be the store's READ-WRITE TOKEN (from Vercel Dashboard → Storage → Resume → .env), NOT a file URL
# When set, resume uploads go to Blob; when unset, resumes go to UPLOAD_DIR (local only).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_hXDDGLXk5uL1e2p1_31ytbXqx1xi0w0Cd381qLzk7gMqDk4"

# Local only: file storage when not using Blob (default: ./uploads)
UPLOAD_DIR=./uploads
