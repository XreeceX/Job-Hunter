# Database (PostgreSQL) – Prisma reads DATABASE_URL only
# Local: postgresql://user:password@localhost:5432/jobhunter?schema=public
# Vercel + Neon: use the connection string from Neon (Vercel may inject POSTGRES_URL – if so, set DATABASE_URL to that value)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# AI
LLM_PROVIDER=groq
GROQ_API_KEY="your_groq_api_key_here"

# Optional: override chat model (OpenAI model name or Groq model id, e.g. llama-3.3-70b-versatile)
# LLM_MODEL=llama-3.3-70b-versatile

# Optional: OpenAI fallback
# LLM_PROVIDER=openai
# OPENAI_API_KEY="your_openai_api_key_here"

# Optional: allow browser on another origin to call /api/* (local tools). Example: http://localhost:3000
# CORS_ORIGIN=http://localhost:3000

# Vercel Blob: must be the store's READ-WRITE TOKEN (from Vercel Dashboard → Storage → Resume → .env), NOT a file URL
# When set, resume uploads go to Blob; when unset, resumes go to UPLOAD_DIR (local only).
BLOB_READ_WRITE_TOKEN="your_vercel_blob_token_here"

# Local only: file storage when not using Blob (default: ./uploads)
UPLOAD_DIR=./uploads

# Optional: live web search (Tavily recommended). Set one key; generation injects recent snippets into the prompt.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY="your_tavily_api_key"
# Or use Serper (Google): SERPER_API_KEY="your_serper_key"

# Optional: portfolio URL for extra AI context (fetched when generating)
# If not set, uses the Portfolio URL from Profile & Resume.
# PORTFOLIO_URL="https://your-portfolio.vercel.app"

# Optional (Vercel): suppress url.parse() deprecation in logs (from dependencies)
# NODE_OPTIONS=--no-deprecation
